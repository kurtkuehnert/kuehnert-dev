---
import { getLegalContent, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  type: "imprint" | "privacy";
}

const { lang, type } = Astro.props;
const legalContent = getLegalContent(lang);
const content = legalContent[type];
---

<section class="container py-24">
  <div class="max-w-4xl mx-auto">
    <h1 class="heading-gradient text-4xl font-bold mb-12 text-center">
      {content.title}
    </h1>

    {
      type === "imprint" ? (
        lang === "de" ? (
          <div class="legal-content space-y-8">
            <div class="text-center">
              <p class="text-lg">
                <>
                  <strong>Kurt Kühnert</strong>
                  <br />
                </>
                Bahnhofstraße 13
                <br />
                08118 Hartenstein
                <br />
                Deutschland
              </p>
            </div>

            <div class="text-center">
              <p class="text-lg">
                <>
                  <strong>Kontakt:</strong>
                  <br />
                </>
                E-Mail:{" "}
                <>
                  <a class="link" href="mailto:kurt@kuehnert.dev">
                    kurt@kuehnert.dev
                  </a>
                  <br />
                </>
                Telefon:{" "}
                <a class="link" href="tel:+49-172-7639811">
                  +49 172 7639811
                </a>
              </p>
            </div>
          </div>
        ) : (
          <div class="legal-content space-y-8">
            <div class="text-center">
              <p class="text-lg">
                <>
                  <strong>Kurt Kühnert</strong>
                  <br />
                </>
                Bahnhofstraße 13
                <br />
                08118 Hartenstein
                <br />
                Germany
              </p>
            </div>

            <div class="text-center">
              <p class="text-lg">
                <>
                  <strong>Contact:</strong>
                  <br />
                </>
                Email:{" "}
                <>
                  <a class="link" href="mailto:kurt@kuehnert.dev">
                    kurt@kuehnert.dev
                  </a>
                  <br />
                </>
                Phone:{" "}
                <a class="link" href="tel:+49-172-7639811">
                  +49 172 7639811
                </a>
              </p>
            </div>
          </div>
        )
      ) : lang === "de" ? (
        <div class="legal-content space-y-8">
          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              1. Verantwortlicher
            </h2>
            <p class="mb-4">
              Verantwortlich für die Verarbeitung personenbezogener Daten auf
              dieser Website:
            </p>
            <div class="text-center mb-6">
              <p class="text-lg">
                <>
                  <strong>Kurt Kühnert</strong>
                  <br />
                </>
                Bahnhofstraße 13
                <br />
                08118 Hartenstein
                <br />
                Deutschland
              </p>
            </div>
            <div class="text-center mb-6">
              <p class="text-lg">
                <>
                  <strong>Kontakt:</strong>
                  <br />
                </>
                E-Mail:{" "}
                <>
                  <a class="link" href="mailto:kurt@kuehnert.dev">
                    kurt@kuehnert.dev
                  </a>
                  <br />
                </>
                Telefon:{" "}
                <a class="link" href="tel:+49-172-7639811">
                  +49 172 7639811
                </a>
              </p>
            </div>
          </div>

          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              2. Hosting über Cloudflare Pages
            </h2>
            <p class="mb-4">
              Diese Website wird über <strong>Cloudflare Pages</strong>{" "}
              bereitgestellt, einen Dienst der
              <strong>
                Cloudflare, Inc., 101 Townsend St., San Francisco, CA 94107, USA
              </strong>
              .
            </p>
            <p class="mb-4">
              Beim Zugriff auf diese Website verarbeitet Cloudflare automatisch
              technische Zugriffsdaten, insbesondere:
            </p>
            <ul class="list-disc pl-6 mb-4 space-y-1">
              <li>IP-Adresse</li>
              <li>Browsertyp und -version</li>
              <li>Betriebssystem</li>
              <li>Zeitpunkt des Zugriffs</li>
              <li>angefragte URL und technische Verbindungsdaten</li>
            </ul>
            <p class="mb-4">
              Diese Daten werden zur{" "}
              <strong>
                Sicherheit, Auslieferung und technischen Bereitstellung der
                Website
              </strong>{" "}
              verarbeitet. Weitere Informationen findest du in der
              <a
                class="link"
                href="https://www.cloudflare.com/privacypolicy/"
                target="_blank"
                rel="noreferrer"
              >
                Datenschutzerklärung von Cloudflare
              </a>
              .
            </p>
            <p class="mb-4">
              Cloudflare verarbeitet Daten ggf. in den <strong>USA</strong>. Die
              Übermittlung erfolgt auf Grundlage des{" "}
              <strong>Data Processing Addendum</strong> und der{" "}
              <strong>EU-Standardvertragsklauseln (SCCs)</strong> gemäß Art. 46
              DSGVO.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              3. Deine Rechte
            </h2>
            <p class="mb-4">Du hast das Recht auf:</p>
            <ul class="list-disc pl-6 mb-4 space-y-1">
              <li>
                <strong>Auskunft</strong> (Art. 15 DSGVO) über die bei mir
                gespeicherten Daten
              </li>
              <li>
                <strong>Löschung</strong> (Art. 17 DSGVO), soweit keine
                gesetzlichen Aufbewahrungspflichten bestehen
              </li>
              <li>
                <strong>Einschränkung der Verarbeitung</strong> (Art. 18 DSGVO)
              </li>
              <li>
                <strong>Datenübertragbarkeit</strong> (Art. 20 DSGVO)
              </li>
              <li>
                <strong>Widerspruch</strong> gegen die Verarbeitung (Art. 21
                DSGVO)
              </li>
            </ul>
            <p>
              Zur Ausübung deiner Rechte kannst du mich unter den oben
              angegebenen Kontaktdaten erreichen.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              4. Links zu externen Websites
            </h2>
            <p class="mb-4">
              Auf dieser Website finden sich Links zu externen Websites, wie zum
              Beispiel meine Profile auf sozialen Netzwerken und Plattformen.
              Diese Seiten werden von Dritten betrieben und unterliegen deren
              eigenen Datenschutzrichtlinien. Ich habe keinen Einfluss auf die
              Verarbeitung von personenbezogenen Daten auf diesen externen
              Seiten. Für weitere Informationen zur Verarbeitung von Daten auf
              diesen Seiten verweise ich auf die Datenschutzerklärungen der
              jeweiligen Anbieter.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              5. Änderungen dieser Datenschutzerklärung
            </h2>
            <p>
              Diese Datenschutzerklärung kann bei Bedarf aktualisiert werden, um
              rechtlichen Anforderungen zu entsprechen.
            </p>
          </div>
        </div>
      ) : (
        <div class="legal-content space-y-8">
          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              1. Responsible Party
            </h2>
            <p class="mb-4">
              Responsible for the processing of personal data on this website:
            </p>
            <div class="text-center mb-6">
              <p class="text-lg">
                <>
                  <strong>Kurt Kühnert</strong>
                  <br />
                </>
                Bahnhofstraße 13
                <br />
                08118 Hartenstein
                <br />
                Germany
              </p>
            </div>
            <div class="text-center mb-6">
              <p class="text-lg">
                <>
                  <strong>Contact:</strong>
                  <br />
                </>
                Email:{" "}
                <>
                  <a class="link" href="mailto:kurt@kuehnert.dev">
                    kurt@kuehnert.dev
                  </a>
                  <br />
                </>
                Phone:{" "}
                <a class="link" href="tel:+49-172-7639811">
                  +49 172 7639811
                </a>
              </p>
            </div>
          </div>

          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              2. Hosting via Cloudflare Pages
            </h2>
            <p class="mb-4">
              This website is served via <strong>Cloudflare Pages</strong>, a
              service of
              <strong>
                Cloudflare, Inc., 101 Townsend St., San Francisco, CA 94107, USA
              </strong>
              .
            </p>
            <p class="mb-4">
              When accessing this website, Cloudflare automatically processes
              technical access data, particularly:
            </p>
            <ul class="list-disc pl-6 mb-4 space-y-1">
              <li>IP address</li>
              <li>Browser type and version</li>
              <li>Operating system</li>
              <li>Time of access</li>
              <li>Requested URL and technical connection data</li>
            </ul>
            <p class="mb-4">
              This data is processed for{" "}
              <strong>
                security, delivery, and technical provision of the website
              </strong>
              . For more information, see the
              <a
                class="link"
                href="https://www.cloudflare.com/privacypolicy/"
                target="_blank"
                rel="noreferrer"
              >
                Cloudflare Privacy Policy
              </a>
              .
            </p>
            <p class="mb-4">
              Cloudflare may process data in the <strong>USA</strong>. The
              transfer is based on Cloudflare's
              <strong>Data Processing Addendum</strong> and{" "}
              <strong>EU Standard Contractual Clauses (SCCs)</strong>
              pursuant to Art. 46 GDPR.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              3. Your Rights
            </h2>
            <p class="mb-4">You have the right to:</p>
            <ul class="list-disc pl-6 mb-4 space-y-1">
              <li>
                <strong>Information</strong> (Art. 15 GDPR) about the data
                stored with me
              </li>
              <li>
                <strong>Deletion</strong> (Art. 17 GDPR), insofar as no legal
                retention obligations exist
              </li>
              <li>
                <strong>Restriction of processing</strong> (Art. 18 GDPR)
              </li>
              <li>
                <strong>Data portability</strong> (Art. 20 GDPR)
              </li>
              <li>
                <strong>Objection</strong> to processing (Art. 21 GDPR)
              </li>
            </ul>
            <p>
              To exercise your rights, you can contact me at the contact details
              provided above.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              4. Links to External Websites
            </h2>
            <p class="mb-4">
              This website contains links to external websites, such as my
              profiles on social networks and platforms. These pages are
              operated by third parties and are subject to their own privacy
              policies. I have no influence on the processing of personal data
              on these external pages. For more information about data
              processing on these pages, I refer to the privacy statements of
              the respective providers.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-semibold mb-4 gradient-text">
              5. Changes to this Privacy Policy
            </h2>
            <p>
              This privacy policy may be updated as needed to comply with legal
              requirements.
            </p>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .legal-content {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .legal-content h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
  }

  .legal-content p {
    margin-bottom: 1rem;
  }

  .legal-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
  }

  .legal-content li + li {
    margin-top: 0.25rem;
  }

  .legal-content strong {
    color: #fff;
    font-weight: 600;
  }
</style>
